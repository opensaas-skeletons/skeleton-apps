# ============================================
# Skeleton Tasks — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skeleton_tasks
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Seed ----
# Set to "true" to run seed on Docker container start
SEED_ON_START=true

# ---- Auth (uncomment when implementing) ----
# JWT_SECRET=your-secret-key-here
