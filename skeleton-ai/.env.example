# Database
DB_HOST=localhost
DB_PORT=5437
DB_NAME=skeleton_ai
DB_USER=postgres
DB_PASSWORD=postgres

# Server
PORT=3006
CORS_ORIGIN=*
NODE_ENV=development

# Authentication (optional)
AUTH_ENABLED=false
API_KEY=
JWT_SECRET=

# LLM Provider: ollama | anthropic | openai
LLM_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434

# Anthropic (optional)
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Seed on start (Docker only)
SEED_ON_START=true

# GitHub Sync
SYNC_ENABLED=true
SYNC_REPO_PATH=/app/repos
# Default sync schedule (cron expression)
SYNC_SCHEDULE=0 3 * * 0
# GitHub Personal Access Token (for private repos)
GITHUB_TOKEN=
