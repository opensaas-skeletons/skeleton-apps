# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skeleton_automation
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Server ----
PORT=3002
# CORS: Use "*" for development. Restrict to specific origins in production.
CORS_ORIGIN=*
NODE_ENV=development

# ---- Redis (for job queue / scheduler) ----
REDIS_URL=redis://localhost:6379

# ---- Seed ----
SEED_ON_START=true

# ---- Email (SMTP) ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com

# ---- Auth ----
# Set AUTH_ENABLED=true to require authentication on API routes.
# Supports both API key (x-api-key header) and JWT Bearer token auth.
# AUTH_ENABLED=true
# API_KEY=your-api-key-here
# JWT_SECRET=your-jwt-secret-key-here
